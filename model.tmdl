model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	discourageImplicitMeasures
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0
annotation PBI_QueryOrder = ["Financials_Origem","D_Produtos","D_Produtos_Detalhes","D_Descontos","D_Detalhes","F_Vendas","D_Calendario"]
annotation PBI_ProTooling = ["DevMode"]

ref table Financials_Origem
ref table D_Produtos
ref table D_Produtos_Detalhes
ref table D_Descontos
ref table D_Detalhes
ref table F_Vendas
ref table D_Calendario
