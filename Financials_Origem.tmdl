table Financials_Origem

	isHidden

	/// Segmento comercial da transacao.
	column Segment
		dataType: string
		summarizeBy: none
		sourceColumn: Segment

	column Country
		dataType: string
		summarizeBy: none
		sourceColumn: Country

	column Product
		dataType: string
		summarizeBy: none
		sourceColumn: Product

	column 'Discount Band'
		dataType: string
		summarizeBy: none
		sourceColumn: Discount Band

	column 'Units Sold'
		dataType: decimal
		summarizeBy: sum
		sourceColumn: Units Sold

	column 'Manufacturing Price'
		dataType: int64
		summarizeBy: sum
		sourceColumn: Manufacturing Price

	column 'Sale Price'
		dataType: int64
		summarizeBy: sum
		sourceColumn: Sale Price

	column 'Gross Sales'
		dataType: decimal
		summarizeBy: sum
		sourceColumn: Gross Sales

	column Discounts
		dataType: decimal
		summarizeBy: sum
		sourceColumn: Discounts

	column Sales
		dataType: decimal
		summarizeBy: sum
		sourceColumn: Sales

	column COGS
		dataType: decimal
		summarizeBy: sum
		sourceColumn: COGS

	column Profit
		dataType: decimal
		summarizeBy: sum
		sourceColumn: Profit

	column Date
		dataType: dateTime
		formatString: dd/MM/yyyy
		summarizeBy: none
		sourceColumn: Date

	column 'Month Number'
		dataType: int64
		summarizeBy: none
		sourceColumn: Month Number

	column 'Month Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Month Name

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: Year

